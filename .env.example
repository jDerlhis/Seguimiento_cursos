# Copia este archivo a .env y completa los valores.

HSEC_BASE_URL=https://antapaccay.sam.glencore.net/hsec_web/
HSEC_DASHBOARD_URL=https://antapaccay.sam.glencore.net/hsec_web/#/dashboard
HSEC_USERNAME=
HSEC_PASSWORD=

# Webhook opcional: recibe eventos hsec.mfa.required, hsec.auth.success, hsec.auth.failed
PYFLOW_WEBHOOK_URL=

PLAYWRIGHT_HEADLESS=true
# 0 = el modal no se cierra al expirar el código; usa Reenviar código
MFA_WAIT_TIMEOUT_SEC=0

# Lectura automática del código MFA desde el buzón (IMAP)
MFA_EMAIL_ENABLED=true
MFA_IMAP_USER=
MFA_IMAP_PASSWORD=
MFA_IMAP_HOST=sermull.com
MFA_IMAP_PORT=993
MFA_IMAP_FOLDER=INBOX
MFA_POLL_INTERVAL_SEC=4
MFA_POLL_TIMEOUT_SEC=180

# Supabase (Pyflow desktop — reemplaza SQLite)
PY_SUPABASE_URL=
PY_SUPABASE_PUBLISHABLE_KEY=
# Service role: auto-confirma correos al registrarse/iniciar sesión (sin enlace de validación).
# PY_SUPABASE_SERVICE_ROLE_KEY=
# PY_SUPABASE_AUTO_CONFIRM_EMAIL=true
# UUID del tenant (evita 403 si aún no aplicaste migraciones RLS de onboarding)
# SELECT id FROM public.tenants WHERE slug = 'pyflow-desktop';
# PY_SUPABASE_TENANT_ID=
PY_SUPABASE_TENANT_SLUG=pyflow-desktop
